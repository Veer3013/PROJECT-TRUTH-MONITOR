# ProjectTruth Monitor local configuration
APP_NAME=ProjectTruth Monitor
ENVIRONMENT=development

# Replace this value with a long random secret before any non-local use.
SECRET_KEY=replace-with-a-long-random-secret-before-use
DATABASE_URL=sqlite:///./data/projecttruth.db

UPLOAD_DIR=data/uploads
REPORT_DIR=data/reports
MAX_UPLOAD_MB=15

SESSION_COOKIE_SECURE=false
SESSION_COOKIE_NAME=pt_session
SESSION_MAX_AGE_SECONDS=28800
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Live access is off by default. Enabling this flag does not override the
# disabled/unreviewed source policy. Frozen fixtures provide the supported demo/test path.
ENABLE_LIVE_HRERA=false
# Local single-process APScheduler only; keep off when running multiple web workers.
ENABLE_SCHEDULER=false
DEFAULT_MONITORING_CADENCE=weekly
SOURCE_REQUEST_TIMEOUT=15
SOURCE_MAX_RESPONSE_MB=8
HRERA_RATE_LIMIT_SECONDS=3

# Provider interfaces are optional. This repository wires disabled implementations only;
# a concrete provider requires code, policy permission, credentials, and tests.
OCR_PROVIDER=disabled
LLM_PROVIDER=disabled
LLM_API_KEY=

# Process bootstrap default. Report generation uses the active organization's stored
# retention_report_days value; automatic age-based artifact purging is not implemented.
RETENTION_UPLOAD_DAYS=90
RETENTION_REPORT_DAYS=90
# Per-process limits per 60 seconds. Hosted multi-instance use needs a shared limiter.
LOGIN_RATE_LIMIT=10
REFRESH_RATE_LIMIT=20
UPLOAD_RATE_LIMIT=10
